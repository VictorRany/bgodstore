# Copie para .env.local e preencha. Nunca faça commit do .env.local.

# URL pública do site (usada em links, sitemap, compartilhamento e mensagens do WhatsApp)
NEXT_PUBLIC_SITE_URL=https://www.seudominio.com.br

# WhatsApp de atendimento — só dígitos, com DDI 55 + DDD (ex.: 5583999999999)
# Sem ele, os botões de pedido levam ao Instagram.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# E-mail de contato exibido no rodapé (opcional)
NEXT_PUBLIC_CONTACT_EMAIL=

# ── Shopify (opcional) ─────────────────────────────────────────
# Com estas duas variáveis, produtos/preços/estoque vêm da Shopify e o botão
# "Pagar online" aparece no checkout. O token é usado só no servidor.
SHOPIFY_STORE_DOMAIN=
SHOPIFY_STOREFRONT_ACCESS_TOKEN=
# SHOPIFY_API_VERSION=2025-07

# ── Newsletter (opcional) ──────────────────────────────────────
# Webhook que recebe { email, source } (Brevo, Mailchimp via Zapier/Make…).
# Sem ele, a seção de newsletter não aparece.
NEWSLETTER_WEBHOOK_URL=

# ── Desenvolvimento ────────────────────────────────────────────
# 1 = adiciona itens fictícios com preço para testar a sacola. Nunca use em produção.
DEMO_CATALOG=
